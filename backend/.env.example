# Application
APP_NAME=REDPEN
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-recommended
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://redpen:redpen_password@postgres:5432/redpen_db
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage (MinIO/S3)
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=redpen_minio
MINIO_SECRET_KEY=redpen_minio_secret_key_123
MINIO_SECURE=False
MINIO_BUCKET_NAME=redpen-storage

# AWS S3 (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_NAME=

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# AI Model Configuration
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
MISTRAL_OCR_MODEL=pixtral-12b-2409

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# GDPR Defaults
DEFAULT_RETENTION_SUBMISSIONS_DAYS=730
DEFAULT_RETENTION_ARTIFACTS_DAYS=365
DEFAULT_RETENTION_ML_DAYS=365
